# Application
NODE_ENV=development
APP_PORT=4000
APP_METRICS_PORT=9092

# GraphQL
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true
GRAPHQL_DEBUG=true

# gRPC Services
GRPC_USER_SERVICE_URL=localhost:50051
GRPC_TASK_SERVICE_URL=localhost:50052

# Redis Cluster (used for rate limiting + Pub/Sub notification subscriber)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=bff-service:

# Authentication (also used for WebSocket JWT validation)
AUTH_MODE=kong
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600

# Rate Limiting
RATE_LIMIT_USER_LIMIT=100
RATE_LIMIT_USER_WINDOW=60
RATE_LIMIT_IP_LIMIT=50
RATE_LIMIT_IP_WINDOW=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
