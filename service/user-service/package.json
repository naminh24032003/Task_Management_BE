{
  "name": "user-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"tests/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test,tests}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --selectProjects unit",
    "test:unit:watch": "jest --selectProjects unit --watch",
    "test:integration": "jest --selectProjects integration",
    "test:integration:watch": "jest --selectProjects integration --watch",
    "test:arch": "jest --selectProjects architecture",
    "test:contract": "jest --selectProjects contract",
    "test:contract:watch": "jest --selectProjects contract --watch",
    "test:cov": "jest --coverage",
    "test:cov:unit": "jest --selectProjects unit --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "proto:sync": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'scripts\\\\sync-proto.cmd' : 'sh ./scripts/sync-proto.sh', {stdio: 'inherit'})\"",
    "proto:sync:unix": "sh ./scripts/sync-proto.sh",
    "proto:sync:win": "scripts\\sync-proto.cmd",
    "proto:gen": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'scripts\\\\generate-proto.cmd' : 'sh ./scripts/generate-proto.sh', {stdio: 'inherit'})\"",
    "proto:gen:unix": "sh ./scripts/sync-proto.sh && sh ./scripts/generate-proto.sh",
    "proto:watch": "nodemon --watch ../../packages/proto/user -e proto --exec \"npm run proto:gen\"",
    "prebuild": "npm run proto:sync",
    "prestart:dev": "npm run proto:gen"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.55.0",
    "@opentelemetry/instrumentation-grpc": "^0.55.0",
    "@opentelemetry/instrumentation-http": "^0.55.0",
    "@opentelemetry/instrumentation-ioredis": "^0.45.0",
    "@opentelemetry/instrumentation-mongodb": "^0.55.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-metrics": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.26.0",
    "@task-management/shared": "file:../../packages/shared/ts",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "argon2": "^0.44.0",
    "bson": "^6.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.9.2",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.10.0",
    "mongoose": "^8.8.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "ts-proto": "^2.10.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
