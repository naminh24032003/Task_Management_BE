{
  "name": "user-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "proto:sync": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'scripts\\\\sync-proto.cmd' : 'sh ./scripts/sync-proto.sh', {stdio: 'inherit'})\"",
    "proto:sync:unix": "sh ./scripts/sync-proto.sh",
    "proto:sync:win": "scripts\\sync-proto.cmd",
    "proto:gen": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'scripts\\\\generate-proto.cmd' : 'sh ./scripts/generate-proto.sh', {stdio: 'inherit'})\"",
    "proto:gen:unix": "sh ./scripts/sync-proto.sh && sh ./scripts/generate-proto.sh",
    "proto:watch": "nodemon --watch ../../packages/proto/user -e proto --exec \"npm run proto:gen\"",
    "prebuild": "npm run proto:sync",
    "prestart:dev": "npm run proto:gen"
  },
  "dependencies": {
    "@task-management/shared": "file:../../packages/shared/ts",
    "@bufbuild/protobuf": "^2.10.2",
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "mongodb": "^6.21.0",
    "mongoose": "^9.1.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "ts-proto": "^2.10.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
