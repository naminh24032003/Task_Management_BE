# Application Configuration
NODE_ENV=development
PORT=3001
SERVICE_NAME=user-service
GRPC_PORT=50051

# MongoDB Configuration (Sharded Cluster in Minikube)
MONGODB_URI=mongodb://root:password@mongodb-sharded.mongodb-sharded.svc.cluster.local:27017/user-service?authSource=admin
MONGODB_DATABASE=user-service

# MongoDB Connection Pool Configuration
MONGODB_POOL_MIN=
MONGODB_POOL_MAX=

# MongoDB Timeout Configuration (in milliseconds)
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_SERVER_SELECTION_TIMEOUT=30000
MONGODB_HEARTBEAT_FREQUENCY=10000
MONGODB_MAX_IDLE_TIME=600000
MONGODB_WAIT_QUEUE_TIMEOUT=10000

# MongoDB Retry Configuration
MONGODB_RETRY_WRITES=true
MONGODB_RETRY_READS=true

# MongoDB Compression
MONGODB_COMPRESSORS=snappy,zlib

# MongoDB Read/Write Concerns
MONGODB_READ_PREFERENCE=primaryPreferred
MONGODB_READ_CONCERN=majority
MONGODB_WRITE_CONCERN_W=majority
MONGODB_WRITE_CONCERN_WTIMEOUT=5000
MONGODB_WRITE_CONCERN_JOURNAL=true

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=36000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here
REDIS_DB=0
REDIS_KEY_PREFIX=user-service:

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Kafka Configuration
# Local: kubectl port-forward -n kafka svc/kafka 9092:9092
# Get password: kubectl get secret -n kafka kafka-user-passwords -o jsonpath='{.data.client-passwords}' | base64 -d
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=user-service
KAFKA_GROUP_ID=user-service-group
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_USERNAME=kafka-user
KAFKA_PASSWORD=your-kafka-password-here
KAFKA_SSL=false
KAFKA_CONNECTION_TIMEOUT=10000
KAFKA_REQUEST_TIMEOUT=30000

# Kafka Topics
KAFKA_TOPIC_USERS=users
KAFKA_TOPIC_USER_ACTIVITIES=user-activities
KAFKA_TOPIC_NOTIFICATIONS=notifications
KAFKA_TOPIC_DLQ=dead-letter-queue
