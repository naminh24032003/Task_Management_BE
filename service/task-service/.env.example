# Task Service Environment Variables
# Copy this to .env and update values as needed

# ===========================================
# SERVER CONFIGURATION
# ===========================================
HTTP_ADDR=0.0.0.0:9091
GRPC_ADDR=0.0.0.0:50052
SERVER_TIMEOUT=1s

# ===========================================
# MONGODB CONFIGURATION
# ===========================================
# Connection string format: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI=mongodb://username:password@localhost:27017/task-service?authSource=admin
MONGODB_DATABASE=task-service
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_CONNECT_TIMEOUT=10
MONGODB_SERVER_SELECTION_TIMEOUT=30
MONGODB_SOCKET_TIMEOUT=45
MONGODB_READ_PREFERENCE=primaryPreferred
MONGODB_READ_CONCERN=majority
MONGODB_WRITE_CONCERN=majority

# ===========================================
# REDIS CLUSTER CONFIGURATION
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=task-service:
REDIS_READ_TIMEOUT=0.2s
REDIS_WRITE_TIMEOUT=0.2s
REDIS_CONNECT_TIMEOUT=10s
REDIS_MAX_RETRIES=3

# ===========================================
# KAFKA CONFIGURATION
# Local: kubectl port-forward -n kafka svc/kafka 9092:9092
# Get password: kubectl get secret -n kafka kafka-user-passwords -o jsonpath='{.data.client-passwords}' | base64 -d
# ===========================================
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_TASKS=tasks
KAFKA_TOPIC_TASK_ASSIGNMENTS=task-assignments
KAFKA_CONSUMER_GROUP=task-service-group
KAFKA_SASL_ENABLED=true
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=kafka-user
KAFKA_PASSWORD=your-kafka-password-here

# ===========================================
# USER SERVICE (gRPC Client)
# ===========================================
USER_SERVICE_ADDR=localhost:50051

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_OUTPUT=stdout

# ===========================================
# APPLICATION
# ===========================================
APP_ENV=development
