// =============================================================================
// Jenkins Pipeline for Task Service (Golang)
// =============================================================================
// This pipeline builds, tests, and deploys task-service to Kubernetes

pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins
  containers:
  - name: golang
    image: golang:1.23-alpine
    command:
    - cat
    tty: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  - name: docker
    image: docker:24-dind
    securityContext:
      privileged: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  - name: kubectl
    image: bitnami/kubectl:latest
    command:
    - cat
    tty: true
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
'''
        }
    }

    environment {
        SERVICE_NAME = 'task-service'
        SERVICE_PATH = 'service/task-service'
        DOCKER_REGISTRY = credentials('docker-registry-url')
        DOCKER_CREDENTIALS = credentials('docker-registry-credentials')
        IMAGE_NAME = "${DOCKER_REGISTRY}/${SERVICE_NAME}"
        GIT_COMMIT_SHORT = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
        GIT_BRANCH = sh(returnStdout: true, script: 'git rev-parse --abbrev-ref HEAD').trim()
        BUILD_TAG = "${GIT_COMMIT_SHORT}-${BUILD_NUMBER}"
        K8S_NAMESPACE = 'dev'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "🔄 Checking out code..."
                    echo "Branch: ${GIT_BRANCH}, Commit: ${GIT_COMMIT_SHORT}"
                    checkout scm
                }
            }
        }

        stage('Build') {
            steps {
                container('golang') {
                    script {
                        echo "🔨 Building Go application..."
                        sh """
                            cd ${SERVICE_PATH}
                            go mod download
                            CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \\
                                -ldflags="-w -s" \\
                                -o task-service \\
                                ./cmd/task
                        """
                    }
                }
            }
        }

        stage('Test') {
            steps {
                container('golang') {
                    script {
                        echo "🧪 Running tests..."
                        sh """
                            cd ${SERVICE_PATH}
                            go test -v ./... || true
                        """
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                container('docker') {
                    script {
                        echo "🐳 Building Docker image..."
                        sh """
                            docker build \\
                                -t ${IMAGE_NAME}:${BUILD_TAG} \\
                                -t ${IMAGE_NAME}:latest \\
                                -t ${IMAGE_NAME}:${GIT_BRANCH} \\
                                -f ${SERVICE_PATH}/Dockerfile \\
                                ${SERVICE_PATH}
                        """
                    }
                }
            }
        }

        stage('Docker Push') {
            steps {
                container('docker') {
                    script {
                        echo "📤 Pushing Docker image..."
                        sh """
                            echo ${DOCKER_CREDENTIALS_PSW} | docker login ${DOCKER_REGISTRY} -u ${DOCKER_CREDENTIALS_USR} --password-stdin
                            docker push ${IMAGE_NAME}:${BUILD_TAG}
                            docker push ${IMAGE_NAME}:latest
                            docker push ${IMAGE_NAME}:${GIT_BRANCH}
                        """
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }
            steps {
                container('kubectl') {
                    script {
                        echo "🚀 Deploying to Kubernetes..."
                        sh """
                            kubectl set image deployment/${SERVICE_NAME} \\
                                ${SERVICE_NAME}=${IMAGE_NAME}:${BUILD_TAG} \\
                                -n ${K8S_NAMESPACE}
                            kubectl rollout status deployment/${SERVICE_NAME} -n ${K8S_NAMESPACE} --timeout=5m
                        """
                    }
                }
            }
        }

        stage('Verify') {
            when {
                branch 'main'
            }
            steps {
                container('kubectl') {
                    script {
                        echo "✅ Verifying deployment..."
                        sh """
                            kubectl get pods -n ${K8S_NAMESPACE} -l app=${SERVICE_NAME}
                            kubectl get svc ${SERVICE_NAME} -n ${K8S_NAMESPACE}
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed: ${SERVICE_NAME}:${BUILD_TAG}"
        }
        failure {
            echo "❌ Pipeline failed at stage: ${env.STAGE_NAME}"
        }
    }
}
