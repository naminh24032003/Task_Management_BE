    store.removeCredentials(domain, existingGithubCred)
    println "Removed existing github-token credential"
}

store.addCredentials(domain, githubCredentials)
println "Added github-token credential"
*/

// Save configuration
jenkins.save()

println "=== Credentials Setup Complete ==="