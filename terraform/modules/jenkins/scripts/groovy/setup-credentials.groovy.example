    CredentialsScope.GLOBAL,
    "docker-registry",
    "Docker Registry Credentials",
    dockerUsername,
    dockerPassword
)

// Remove existing credential if exists
def existingDockerCred = store.getCredentials(domain).find { it.id == "docker-registry" }
if (existingDockerCred) {
    store.removeCredentials(domain, existingDockerCred)
    println "Removed existing docker-registry credential"
}

// Add new credential
store.addCredentials(domain, dockerCredentials)
println "Added docker-registry credential"
