    {
      "module": "module.tracing[0]",
      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "otel_collector",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "index_key": 0,
          "schema_version": 0,
          "attributes": {
            "binary_data": null,
            "data": {
              "config.yaml": "# =============================================================================\r\n# OpenTelemetry Collector Configuration\r\n# =============================================================================\r\n# Central collector for receiving traces from all services\r\n# =============================================================================\r\n\r\nreceivers:\r\n  otlp:\r\n    protocols:\r\n      grpc:\r\n        endpoint: 0.0.0.0:4317\r\n      http:\r\n        endpoint: 0.0.0.0:4318\r\n        cors:\r\n          allowed_origins:\r\n            - \"*\"\r\n\r\nprocessors:\r\n  # Batch processor for efficiency\r\n  batch:\r\n    timeout: 3s\r\n    send_batch_size: 200\r\n    send_batch_max_size: 1000\r\n\r\n  # Memory limiter to prevent OOM\r\n  memory_limiter:\r\n    check_interval: 1s\r\n    limit_mib: 200\r\n    spike_limit_mib: 50\r\n\r\n  # Add resource attributes\r\n  resource:\r\n    attributes:\r\n      - key: deployment.environment\r\n        value: minikube\r\n        action: upsert\r\n\r\n  # Probabilistic sampling (if needed)\r\n  # probabilistic_sampler:\r\n  #   sampling_percentage: 100\r\n\r\nexporters:\r\n  # Export to Tempo\r\n  otlp/tempo:\r\n    endpoint: tempo.tracing.svc.cluster.local:4317\r\n    tls:\r\n      insecure: true\r\n\r\n  # Debug logging (set verbosity: detailed for troubleshooting)\r\n  logging:\r\n    verbosity: normal\r\n    sampling_initial: 5\r\n    sampling_thereafter: 200\r\n\r\nextensions:\r\n  # Health check endpoint\r\n  health_check:\r\n    endpoint: 0.0.0.0:13133\r\n    path: \"/health\"\r\n\r\n  # pprof for debugging\r\n  pprof:\r\n    endpoint: 0.0.0.0:1888\r\n\r\n  # zPages for debugging\r\n  zpages:\r\n    endpoint: 0.0.0.0:55679\r\n\r\nservice:\r\n  extensions: [health_check, pprof, zpages]\r\n  \r\n  pipelines:\r\n    traces:\r\n      receivers: [otlp]\r\n      processors: [memory_limiter, resource, batch]\r\n      exporters: [otlp/tempo, logging]\r\n\r\n  telemetry:\r\n    logs:\r\n      level: info\r\n    metrics:\r\n      address: 0.0.0.0:8888\r\n"
            },
            "id": "tracing/otel-collector-config",
            "immutable": false,
            "metadata": [
              {
                "annotations": null,
                "generate_name": "",
                "generation": 0,
                "labels": {
                  "app.kubernetes.io/managed-by": "terraform",
                  "environment": "dev"
                },
                "name": "otel-collector-config",
                "namespace": "tracing",
                "resource_version": "1118750",
                "uid": "dba15871-122b-4a79-ac43-dd65df1c7755"
              }
            ]
          },
          "sensitive_attributes": [],
          "private": "bnVsbA==",
          "dependencies": [
            "module.monitoring.data.kubernetes_service.alertmanager",
            "module.monitoring.data.kubernetes_service.grafana",
            "module.monitoring.data.kubernetes_service.prometheus",
            "module.monitoring.helm_release.kube_prometheus_stack",
            "module.monitoring.kubernetes_namespace.monitoring",
