            "yaml_body": "apiVersion: networking.istio.io/v1beta1\r\nkind: VirtualService\r\nmetadata:\r\n  name: task-service\r\n  namespace: dev\r\nspec:\r\n  hosts:\r\n    - task-service.dev.svc.cluster.local\r\n  \r\n  # HTTP Routes\r\n  http:\r\n    - name: \"task-service-http\"\r\n      match:\r\n        - port: 8080\r\n      timeout: 10s\r\n      retries:\r\n        attempts: 3\r\n        perTryTimeout: 3s\r\n        retryOn: gateway-error,connect-failure,refused-stream,unavailable,cancelled,retriable-4xx\r\n      route:\r\n        - destination:\r\n            host: task-service.dev.svc.cluster.local\r\n            subset: v1\r\n            port:\r\n              number: 8080\r\n          weight: 100\r\n  \r\n  # gRPC Routes\r\n    - name: \"task-service-grpc\"\r\n      match:\r\n        - port: 9090\r\n      timeout: 10s\r\n      retries:\r\n        attempts: 3\r\n        perTryTimeout: 3s\r\n        retryOn: gateway-error,connect-failure,refused-stream,unavailable,cancelled,retriable-4xx\r\n      route:\r\n        - destination:\r\n            host: task-service.dev.svc.cluster.local\r\n            subset: v1\r\n            port:\r\n              number: 9090\r\n          weight: 100\r\n",
