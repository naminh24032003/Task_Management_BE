    {
      "module": "module.tracing[0]",
      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "grafana_tempo_datasource",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "index_key": 0,
          "schema_version": 0,
          "attributes": {
            "binary_data": {},
            "data": {
              "tempo-datasource.yaml": "\"apiVersion\": 1\n\"datasources\":\n- \"access\": \"proxy\"\n  \"editable\": true\n  \"isDefault\": false\n  \"jsonData\":\n    \"httpMethod\": \"GET\"\n    \"lokiSearch\":\n      \"datasourceUid\": \"loki\"\n    \"nodeGraph\":\n      \"enabled\": true\n    \"serviceMap\":\n      \"datasourceUid\": \"prometheus\"\n    \"tracesToLogs\":\n      \"datasourceUid\": \"loki\"\n      \"filterBySpanID\": true\n      \"filterByTraceID\": true\n      \"mappedTags\":\n      - \"key\": \"service.name\"\n        \"value\": \"service\"\n      \"spanEndTimeShift\": \"1h\"\n      \"spanStartTimeShift\": \"1h\"\n      \"tags\":\n      - \"job\"\n      - \"pod\"\n      - \"namespace\"\n    \"tracesToMetrics\":\n      \"datasourceUid\": \"prometheus\"\n      \"queries\":\n      - \"name\": \"Request rate\"\n        \"query\": \"sum(rate(traces_spanmetrics_calls_total{$$__tags}[5m]))\"\n      \"tags\":\n      - \"key\": \"service.name\"\n        \"value\": \"service\"\n  \"name\": \"Tempo\"\n  \"type\": \"tempo\"\n  \"url\": \"http://tempo.tracing.svc.cluster.local:3200\"\n"
            },
            "id": "monitoring/grafana-datasource-tempo",
