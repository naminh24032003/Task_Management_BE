            "wait_for_rollout": true,
            "yaml_body": "apiVersion: networking.istio.io/v1beta1\r\nkind: VirtualService\r\nmetadata:\r\n  name: user-service\r\n  namespace: dev\r\nspec:\r\n  hosts:\r\n    - user-service.dev.svc.cluster.local\r\n  \r\n  # HTTP Routes\r\n  http:\r\n    - name: \"user-service-http\"\r\n      match:\r\n        - port: 3000\r\n      timeout: 10s\r\n      retries:\r\n        attempts: 3\r\n        perTryTimeout: 3s\r\n        retryOn: gateway-error,connect-failure,refused-stream,unavailable,cancelled,retriable-4xx\r\n      route:\r\n        - destination:\r\n            host: user-service.dev.svc.cluster.local\r\n            subset: v1\r\n            port:\r\n              number: 3000\r\n          weight: 100\r\n  \r\n  # gRPC Routes\r\n    - name: \"user-service-grpc\"\r\n      match:\r\n        - port: 9090\r\n      timeout: 10s\r\n      retries:\r\n        attempts: 3\r\n        perTryTimeout: 3s\r\n        retryOn: gateway-error,connect-failure,refused-stream,unavailable,cancelled,retriable-4xx\r\n      route:\r\n        - destination:\r\n            host: user-service.dev.svc.cluster.local\r\n            subset: v1\r\n            port:\r\n              number: 9090\r\n          weight: 100\r\n",
            "yaml_body_parsed": "apiVersion: networking.istio.io/v1beta1\nkind: VirtualService\nmetadata:\n  name: user-service\n  namespace: dev\nspec:\n  hosts:\n  - user-service.dev.svc.cluster.local\n  http:\n  - match:\n    - port: 3000\n    name: user-service-http\n    retries:\n      attempts: 3\n      perTryTimeout: 3s\n      retryOn: gateway-error,connect-failure,refused-stream,unavailable,cancelled,retriable-4xx\n    route:\n    - destination:\n        host: user-service.dev.svc.cluster.local\n        port:\n          number: 3000\n        subset: v1\n      weight: 100\n    timeout: 10s\n  - match:\n    - port: 9090\n    name: user-service-grpc\n    retries:\n      attempts: 3\n      perTryTimeout: 3s\n      retryOn: gateway-error,connect-failure,refused-stream,unavailable,cancelled,retriable-4xx\n    route:\n    - destination:\n        host: user-service.dev.svc.cluster.local\n        port:\n          number: 9090\n        subset: v1\n      weight: 100\n    timeout: 10s\n",
