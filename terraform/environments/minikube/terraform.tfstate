    "jenkins_access_info": {
      "value": "To access Jenkins:\r\n1. Get the NodePort:\r\n   kubectl get svc -n jenkins jenkins-jenkins -o jsonpath='{.spec.ports[0].nodePort}'\r\n\r\n2. Get Minikube IP:\r\n   minikube ip\r\n\r\n3. Access Jenkins at: http://\u003cminikube-ip\u003e:\u003cnode-port\u003e\r\n\r\nOr use port forwarding:\r\n   kubectl port-forward -n jenkins svc/jenkins-jenkins 8080:80\r\n   Then access at: http://localhost:8080\r\n\r\nLogin credentials:\r\n   Username: admin\r\n   Password: \u003cyour-jenkins-password\u003e\r\n",
      "type": "string"
    },
    "jenkins_namespace": {
      "value": "jenkins",
      "type": "string"
    },
