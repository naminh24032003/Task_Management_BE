                "revision": 1,
                "values": "{\"persistence\":{\"enabled\":false,\"size\":\"10Gi\"},\"podAnnotations\":{\"prometheus.io/path\":\"/metrics\",\"prometheus.io/port\":\"3200\",\"prometheus.io/scrape\":\"true\"},\"resources\":{\"limits\":{\"cpu\":\"300m\",\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"service\":{\"type\":\"ClusterIP\"},\"tempo\":{\"compactor\":{\"compaction\":{\"block_retention\":\"48h\"}},\"metricsGenerator\":{\"enabled\":true,\"remoteWrite\":[{\"send_exemplars\":true,\"url\":\"http://monitoring-kube-prometheus-prometheus.monitoring:9090/api/v1/write\"}],\"ringKVStore\":{\"store\":\"inmemory\"}},\"multitenancyEnabled\":false,\"queryFrontend\":{\"search\":{\"duration_slo\":\"5s\",\"throughput_bytes_slo\":1073741824}},\"receivers\":{\"otlp\":{\"protocols\":{\"grpc\":{\"endpoint\":\"0.0.0.0:4317\"},\"http\":{\"endpoint\":\"0.0.0.0:4318\"}}}},\"storage\":{\"trace\":{\"backend\":\"local\",\"block\":{},\"local\":{\"path\":\"/var/tempo/traces\"},\"wal\":{\"path\":\"/var/tempo/wal\"}}}}}",
                "version": "1.7.2"
              }
            ],
            "name": "tempo",
            "namespace": "tracing",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": "https://grafana.github.io/helm-charts",
            "repository_ca_file": null,
            "repository_cert_file": null,
