      "instances": [
        {
          "index_key": "task-service",
          "schema_version": 1,
          "attributes": {
            "api_version": "networking.istio.io/v1beta1",
            "apply_only": false,
            "force_conflicts": false,
            "force_new": false,
            "id": "/apis/networking.istio.io/v1beta1/namespaces/dev/virtualservices/task-service",
            "ignore_fields": null,
            "kind": "VirtualService",
            "live_manifest_incluster": "a60932bd7df647fee7e7d56bec4198daf244d00f57d1b01c361fb08c7a15fd1a",
            "live_uid": "dd91f1bf-69c3-4812-9215-e23008786aa9",
            "name": "task-service",
            "namespace": "dev",
            "override_namespace": null,
            "sensitive_fields": null,
            "server_side_apply": false,
            "timeouts": null,
            "uid": "dd91f1bf-69c3-4812-9215-e23008786aa9",
            "validate_schema": true,
            "wait": null,
            "wait_for_rollout": true,
            "yaml_body": "apiVersion: networking.istio.io/v1beta1\r\nkind: VirtualService\r\nmetadata:\r\n  name: task-service\r\n  namespace: dev\r\nspec:\r\n  hosts:\r\n    - task-service.dev.svc.cluster.local\r\n  \r\n  # HTTP Routes\r\n  http:\r\n    - name: \"task-service-http\"\r\n      match:\r\n        - port: 8080\r\n      timeout: 10s\r\n      retries:\r\n        attempts: 3\r\n        perTryTimeout: 3s\r\n        retryOn: gateway-error,connect-failure,refused-stream,unavailable,cancelled,retriable-4xx\r\n      route:\r\n        - destination:\r\n            host: task-service.dev.svc.cluster.local\r\n            subset: v1\r\n            port:\r\n              number: 8080\r\n          weight: 100\r\n  \r\n  # gRPC Routes\r\n    - name: \"task-service-grpc\"\r\n      match:\r\n        - port: 9090\r\n      timeout: 10s\r\n      retries:\r\n        attempts: 3\r\n        perTryTimeout: 3s\r\n        retryOn: gateway-error,connect-failure,refused-stream,unavailable,cancelled,retriable-4xx\r\n      route:\r\n        - destination:\r\n            host: task-service.dev.svc.cluster.local\r\n            subset: v1\r\n            port:\r\n              number: 9090\r\n          weight: 100\r\n",
            "yaml_body_parsed": "apiVersion: networking.istio.io/v1beta1\nkind: VirtualService\nmetadata:\n  name: task-service\n  namespace: dev\nspec:\n  hosts:\n  - task-service.dev.svc.cluster.local\n  http:\n  - match:\n    - port: 8080\n    name: task-service-http\n    retries:\n      attempts: 3\n      perTryTimeout: 3s\n      retryOn: gateway-error,connect-failure,refused-stream,unavailable,cancelled,retriable-4xx\n    route:\n    - destination:\n        host: task-service.dev.svc.cluster.local\n        port:\n          number: 8080\n        subset: v1\n      weight: 100\n    timeout: 10s\n  - match:\n    - port: 9090\n    name: task-service-grpc\n    retries:\n      attempts: 3\n      perTryTimeout: 3s\n      retryOn: gateway-error,connect-failure,refused-stream,unavailable,cancelled,retriable-4xx\n    route:\n    - destination:\n        host: task-service.dev.svc.cluster.local\n        port:\n          number: 9090\n        subset: v1\n      weight: 100\n    timeout: 10s\n",
