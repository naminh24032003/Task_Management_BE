            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "# =============================================================================\r\n# Tempo Helm Values Template\r\n# =============================================================================\r\n\r\n# Tempo configuration\r\ntempo:\r\n  # Multitenancy\r\n  multitenancyEnabled: false\r\n  \r\n  # Receivers configuration\r\n  receivers:\r\n    otlp:\r\n      protocols:\r\n        grpc:\r\n          endpoint: \"0.0.0.0:4317\"\r\n        http:\r\n          endpoint: \"0.0.0.0:4318\"\r\n\r\n  # Storage configuration  \r\n  storage:\r\n    trace:\r\n      backend: local\r\n      local:\r\n        path: /var/tempo/traces\r\n      wal:\r\n        path: /var/tempo/wal\r\n      block: {}\r\n\r\n  # Compactor\r\n  compactor:\r\n    compaction:\r\n      block_retention: 48h\r\n\r\n  # Query frontend\r\n  queryFrontend:\r\n    search:\r\n      duration_slo: 5s\r\n      throughput_bytes_slo: 1.073741824e+09\r\n\r\n  # Metrics generator (for service graphs)\r\n  metricsGenerator:\r\n    enabled: true\r\n    ringKVStore:\r\n      store: inmemory\r\n    remoteWrite:\r\n    - url: http://monitoring-kube-prometheus-prometheus.monitoring:9090/api/v1/write\r\n      send_exemplars: true\r\n\r\n# Persistence\r\npersistence:\r\n  enabled: false\r\n  size: 10Gi\r\n\r\n# Resources\r\nresources:\r\n  requests:\r\n    cpu: 50m\r\n    memory: 128Mi\r\n  limits:\r\n    cpu: 300m\r\n    memory: 256Mi\r\n\r\n# Service configuration\r\nservice:\r\n  type: ClusterIP\r\n\r\n# Pod annotations for Prometheus scraping\r\npodAnnotations:\r\n  prometheus.io/scrape: \"true\"\r\n  prometheus.io/port: \"3200\"\r\n  prometheus.io/path: \"/metrics\"\r\n"
            ],
            "verify": false,
            "version": "1.7.2",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
