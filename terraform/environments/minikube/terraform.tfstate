      "instances": [
        {
          "index_key": 0,
          "schema_version": 1,
          "attributes": {
            "api_version": "security.istio.io/v1beta1",
            "apply_only": false,
            "force_conflicts": false,
            "force_new": false,
            "id": "/apis/security.istio.io/v1beta1/namespaces/dev/authorizationpolicys/allow-mesh",
            "ignore_fields": null,
            "kind": "AuthorizationPolicy",
            "live_manifest_incluster": "c6c91310f5a70aebeb4ed323a5bb6bb35287c58a1b14cb36cd7bdc3d76b62ec1",
            "live_uid": "c0566652-45f8-4c4d-b420-d1070179b2f0",
            "name": "allow-mesh",
            "namespace": "dev",
            "override_namespace": null,
            "sensitive_fields": null,
            "server_side_apply": false,
            "timeouts": null,
            "uid": "c0566652-45f8-4c4d-b420-d1070179b2f0",
            "validate_schema": true,
            "wait": null,
            "wait_for_rollout": true,
            "yaml_body": "apiVersion: security.istio.io/v1beta1\r\nkind: AuthorizationPolicy\r\nmetadata:\r\n  name: allow-mesh\r\n  namespace: dev\r\nspec:\r\n  action: ALLOW\r\n  rules:\r\n    # Allow traffic from within the mesh\r\n    - from:\r\n        - source:\r\n            principals: [\"cluster.local/ns/dev/sa/*\"]\r\n    # Allow traffic from Kong gateway\r\n    - from:\r\n        - source:\r\n            namespaces: [\"kong\"]\r\n    # Allow traffic from Istio ingress gateway\r\n    - from:\r\n        - source:\r\n            namespaces: [\"istio-system\"]\r\n",
            "yaml_body_parsed": "apiVersion: security.istio.io/v1beta1\nkind: AuthorizationPolicy\nmetadata:\n  name: allow-mesh\n  namespace: dev\nspec:\n  action: ALLOW\n  rules:\n  - from:\n    - source:\n        principals:\n        - cluster.local/ns/dev/sa/*\n  - from:\n    - source:\n        namespaces:\n        - kong\n  - from:\n    - source:\n        namespaces:\n        - istio-system\n",
            "yaml_incluster": "c6c91310f5a70aebeb4ed323a5bb6bb35287c58a1b14cb36cd7bdc3d76b62ec1"
          },
