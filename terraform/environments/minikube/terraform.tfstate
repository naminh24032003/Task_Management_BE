      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "oci://registry-1.docker.io/bitnamicharts/mongodb-sharded",
            "cleanup_on_fail": false,
            "create_namespace": true,
            "dependency_update": false,
