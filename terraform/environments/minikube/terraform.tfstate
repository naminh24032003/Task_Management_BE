            "kind": "DestinationRule",
            "live_manifest_incluster": "64dfd0d851b3bd7f3660d2709e0b324deb31f8378e343eee3cd44cc4c791245e",
            "live_uid": "404380e5-884b-4aef-9d2e-f730dcd07fcd",
            "name": "user-service",
            "namespace": "dev",
            "override_namespace": null,
            "sensitive_fields": null,
            "server_side_apply": false,
            "timeouts": null,
            "uid": "404380e5-884b-4aef-9d2e-f730dcd07fcd",
            "validate_schema": true,
            "wait": null,
            "wait_for_rollout": true,
            "yaml_body": "apiVersion: networking.istio.io/v1beta1\r\nkind: DestinationRule\r\nmetadata:\r\n  name: user-service\r\n  namespace: dev\r\nspec:\r\n  host: user-service.dev.svc.cluster.local\r\n  trafficPolicy:\r\n    # mTLS\r\n    tls:\r\n      mode: ISTIO_MUTUAL\r\n    \r\n    # Connection Pool\r\n    connectionPool:\r\n      tcp:\r\n        maxConnections: 100\r\n        connectTimeout: 10s\r\n      http:\r\n        h2UpgradePolicy: UPGRADE\r\n        http1MaxPendingRequests: 100\r\n        http2MaxRequests: 1000\r\n        maxRequestsPerConnection: 10\r\n        maxRetries: 3\r\n    \r\n    # Circuit Breaker (Outlier Detection)\r\n    outlierDetection:\r\n      consecutive5xxErrors: 5\r\n      interval: 30s\r\n      baseEjectionTime: 30s\r\n      maxEjectionPercent: 100\r\n  \r\n  # Subsets for versioned deployments\r\n  subsets:\r\n    - name: v1\r\n      labels:\r\n        version: v1\r\n",
            "yaml_body_parsed": "apiVersion: networking.istio.io/v1beta1\nkind: DestinationRule\nmetadata:\n  name: user-service\n  namespace: dev\nspec:\n  host: user-service.dev.svc.cluster.local\n  subsets:\n  - labels:\n      version: v1\n    name: v1\n  trafficPolicy:\n    connectionPool:\n      http:\n        h2UpgradePolicy: UPGRADE\n        http1MaxPendingRequests: 100\n        http2MaxRequests: 1000\n        maxRequestsPerConnection: 10\n        maxRetries: 3\n      tcp:\n        connectTimeout: 10s\n        maxConnections: 100\n    outlierDetection:\n      baseEjectionTime: 30s\n      consecutive5xxErrors: 5\n      interval: 30s\n      maxEjectionPercent: 100\n    tls:\n      mode: ISTIO_MUTUAL\n",
            "yaml_incluster": "64dfd0d851b3bd7f3660d2709e0b324deb31f8378e343eee3cd44cc4c791245e"
          },
