# =========================
# Secrets Configuration Example
# =========================
# IMPORTANT: Copy this file to secrets.auto.tfvars and set your real values
#
# Command: cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# The file secrets.auto.tfvars is automatically gitignored and will NOT be committed
# This keeps your sensitive data safe!

# =========================
# Jenkins Credentials
# =========================
jenkins_user     = "admin"
jenkins_password = "CHANGE-ME-TO-A-SECURE-PASSWORD"

# Password requirements:
# - Minimum 8 characters
# - Should include: uppercase, lowercase, numbers, special characters
# - Example: "MyJ3nk!ns2024Secur3"

# =========================
# Future Secrets (uncomment when needed)
# =========================

# GitHub Token (for webhooks and GitHub integration)
# github_token = "ghp_your_github_personal_access_token_here"

# Docker Registry Credentials
# docker_registry_username = "your-docker-username"
# docker_registry_password = "your-docker-password"

# AWS Credentials (for EKS)
# aws_access_key_id     = "AKIAIOSFODNN7EXAMPLE"
# aws_secret_access_key = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# =========================
# Notes
# =========================
# 1. Never commit secrets.auto.tfvars to version control
# 2. Use environment-specific secrets for dev/staging/prod
# 3. Consider using a secret manager (AWS Secrets Manager, HashiCorp Vault) for production
# 4. Rotate passwords regularly
# 5. Use strong, unique passwords for each environment
# =========================
# ArgoCD Credentials
# =========================
argocd_admin_password = "CHANGE-ME-TO-A-SECURE-PASSWORD"
argocd_redis_password = "CHANGE-ME-REDIS-PASSWORD"

# =========================
# ArgoCD Git Repositories (Optional)
# =========================
# argocd_git_repositories = {
#   my-apps = {
#     url             = "git@github.com:your-org/your-repo.git"
#     username        = "git"
#     ssh_private_key = file("~/.ssh/id_rsa")
#     insecure        = false
#   }
# }

# =========================
# ArgoCD Projects (Optional)
# =========================
# argocd_projects = {
#   production = {
#     description  = "Production applications"
#     source_repos = ["*"]
#     destinations = [
#       {
#         server    = "https://kubernetes.default.svc"
#         namespace = "default"
#       }
#     ]
#   }
# }

# =========================
# MongoDB Credentials
# =========================
mongodb_root_password   = "CHANGE-ME-MONGODB-ROOT-PASSWORD"
mongodb_replica_set_key = "CHANGE-ME-MONGODB-REPLICA-KEY"

# =========================
# Kafka Credentials
# =========================
kafka_sasl_password = "CHANGE-ME-KAFKA-SASL-PASSWORD"

# =========================
# Redis Credentials
# =========================
redis_password = "CHANGE-ME-REDIS-PASSWORD"

# Password requirements:
# - Minimum 8 characters
# - Should be strong and unique
# - Example: "RedisSecur3P@ssw0rd2024"

# =========================
# User Service Secrets
# =========================
# JWT Secret for token signing (minimum 32 characters)
# Generate with: openssl rand -base64 32
user_service_jwt_secret = "CHANGE-ME-JWT-SECRET-MIN-32-CHARS"

# MongoDB URI for user-service (if different from default)
# Note: Password special characters must be URL encoded
# @ -> %40, ! -> %21, # -> %23, $ -> %24
# user_service_mongodb_uri = "mongodb://root:password@host:27017/db?authSource=admin"
