apiVersion: v1
kind: ConfigMap
metadata:
  name: kong-config
  namespace: {{ .Release.Namespace }}
  labels:
    app.kubernetes.io/name: kong
    app.kubernetes.io/instance: {{ .Release.Name }}
data:
  kong.yaml: |
    _format_version: "3.0"
    services:
      # Mock service for testing
      - name: mock
        url: http://httpbin.org
        routes:
          - name: mock-route
            protocols:
              - http
              - https
            paths:
              - /test
            strip_path: true

      # Shared gRPC-Gateway - handles HTTP->gRPC for ALL services
      # Pattern-based routing: ALL /v1/* requests go to grpc-gateway
      # grpc-gateway will handle service routing based on path
      - name: grpc-gateway
        url: http://grpc-gateway.kong.svc.cluster.local:8080
        plugins:
          - name: file-log
            config:
              path: /dev/stdout
              reopen: true
          - name: cors
            config:
              origins:
                - "*"
              methods:
                - GET
                - POST
                - PUT
                - PATCH
                - DELETE
                - OPTIONS
              headers:
                - Accept
                - Authorization
                - Content-Type
              exposed_headers:
                - X-Auth-Token
              credentials: true
              max_age: 3600
        routes:
          # Single wildcard route for ALL API v1 traffic
          - name: api-v1-route
            protocols:
              - http
              - https
            paths:
              - /v1
            strip_path: false
            regex_priority: 0