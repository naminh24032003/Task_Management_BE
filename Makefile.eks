# =============================================================================
# EKS Deployment Makefile
# =============================================================================
# Usage:
#   make eks-init          - Initialize Terraform for EKS
#   make eks-plan          - Plan EKS infrastructure
#   make eks-apply         - Apply EKS infrastructure
#   make eks-kubeconfig    - Configure kubectl for EKS
#   make ecr-login         - Login to ECR
#   make build-push SVC=x  - Build & push a specific service to ECR
#   make deploy SVC=x      - Deploy a service to EKS via Helm
#   make deploy-all        - Deploy all services
# =============================================================================

# --- Configuration ---
AWS_REGION      ?= ap-southeast-1
EKS_CLUSTER     ?= task-management-dev
AWS_ACCOUNT_ID  ?= $(shell aws sts get-caller-identity --query Account --output text)
ECR_REGISTRY    ?= $(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com
NAMESPACE       ?= dev
IMAGE_TAG       ?= latest

TF_DIR          = terraform/environments/dev
CHART_DIR       = charts/microservice
SERVICES        = user-service task-service notification-service bff-service

# =============================================================================
# PREREQUISITES
# =============================================================================
.PHONY: prereqs
prereqs:
	@echo "Checking prerequisites..."
	@which aws       > /dev/null || (echo "ERROR: aws-cli not found" && exit 1)
	@which terraform > /dev/null || (echo "ERROR: terraform not found" && exit 1)
	@which kubectl   > /dev/null || (echo "ERROR: kubectl not found" && exit 1)
	@which helm      > /dev/null || (echo "ERROR: helm not found" && exit 1)
	@which docker    > /dev/null || (echo "ERROR: docker not found" && exit 1)
	@echo "✅ All prerequisites satisfied"

# =============================================================================
# TERRAFORM (Infrastructure)
# =============================================================================
.PHONY: eks-init eks-plan eks-apply eks-destroy

eks-init:
	cd $(TF_DIR) && terraform init

eks-plan:
	cd $(TF_DIR) && terraform plan -out=tfplan

eks-apply:
	cd $(TF_DIR) && terraform apply tfplan

eks-destroy:
	cd $(TF_DIR) && terraform destroy

eks-output:
	cd $(TF_DIR) && terraform output

# =============================================================================
# AWS / EKS Configuration
# =============================================================================
.PHONY: eks-kubeconfig ecr-login

eks-kubeconfig:
	aws eks update-kubeconfig --region $(AWS_REGION) --name $(EKS_CLUSTER)
	@echo "✅ kubectl configured for $(EKS_CLUSTER)"

ecr-login:
	aws ecr get-login-password --region $(AWS_REGION) | docker login --username AWS --password-stdin $(ECR_REGISTRY)
	@echo "✅ Logged in to ECR"

# =============================================================================
# CREATE S3 BACKEND (one-time setup)
# =============================================================================
.PHONY: create-backend
create-backend:
	@echo "Creating S3 bucket for Terraform state..."
	aws s3 mb s3://task-management-terraform-state --region $(AWS_REGION)
	aws s3api put-bucket-versioning \
		--bucket task-management-terraform-state \
		--versioning-configuration Status=Enabled
	@echo "Creating DynamoDB table for state locking..."
	aws dynamodb create-table \
		--table-name task-management-terraform-locks \
		--attribute-definitions AttributeName=LockID,AttributeType=S \
		--key-schema AttributeName=LockID,KeyType=HASH \
		--billing-mode PAY_PER_REQUEST \
		--region $(AWS_REGION)
	@echo "✅ Backend resources created"

# =============================================================================
# BUILD & PUSH (Docker → ECR)
# =============================================================================
.PHONY: build-push build-push-all

# Build and push a single service: make build-push SVC=task-service
build-push:
ifndef SVC
	$(error SVC is not set. Usage: make build-push SVC=task-service)
endif
	@echo "Building $(SVC)..."
	@if [ "$(SVC)" = "user-service" ] || [ "$(SVC)" = "bff-service" ]; then \
		docker build -t $(ECR_REGISTRY)/task-management/$(SVC):$(IMAGE_TAG) \
			-f service/$(SVC)/Dockerfile service/$(SVC); \
	else \
		docker build -t $(ECR_REGISTRY)/task-management/$(SVC):$(IMAGE_TAG) \
			-f service/$(SVC)/Dockerfile .; \
	fi
	@echo "Pushing $(SVC) to ECR..."
	docker push $(ECR_REGISTRY)/task-management/$(SVC):$(IMAGE_TAG)
	@echo "✅ $(SVC):$(IMAGE_TAG) pushed to ECR"

build-push-all: ecr-login
	@for svc in $(SERVICES); do \
		$(MAKE) build-push SVC=$$svc IMAGE_TAG=$(IMAGE_TAG); \
	done
	@echo "✅ All services pushed to ECR"

# =============================================================================
# DEPLOY (Helm → EKS)
# =============================================================================
.PHONY: deploy deploy-all

# Deploy a single service: make deploy SVC=task-service
deploy:
ifndef SVC
	$(error SVC is not set. Usage: make deploy SVC=task-service)
endif
	@echo "Deploying $(SVC) to EKS..."
	helm upgrade --install $(SVC) $(CHART_DIR) \
		--namespace $(NAMESPACE) \
		--create-namespace \
		--values apps/$(SVC)/values-eks.yaml \
		--set microservice.image.repository="$(ECR_REGISTRY)/task-management/$(SVC)" \
		--set microservice.image.tag="$(IMAGE_TAG)" \
		--timeout 5m \
		--wait \
		--atomic
	@echo "✅ $(SVC) deployed"

deploy-all:
	@for svc in $(SERVICES); do \
		$(MAKE) deploy SVC=$$svc IMAGE_TAG=$(IMAGE_TAG); \
	done
	@echo "✅ All services deployed to EKS"

# =============================================================================
# STATUS / DEBUG
# =============================================================================
.PHONY: status pods logs

status:
	@echo "=== Deployments ==="
	kubectl get deployments -n $(NAMESPACE)
	@echo ""
	@echo "=== Pods ==="
	kubectl get pods -n $(NAMESPACE)
	@echo ""
	@echo "=== Services ==="
	kubectl get svc -n $(NAMESPACE)

pods:
	kubectl get pods -n $(NAMESPACE) -o wide

logs:
ifndef SVC
	$(error SVC is not set. Usage: make logs SVC=task-service)
endif
	kubectl logs -n $(NAMESPACE) -l app.kubernetes.io/name=$(SVC) --tail=100 -f

# =============================================================================
# FULL SETUP (end-to-end)
# =============================================================================
.PHONY: setup
setup: prereqs create-backend eks-init eks-plan
	@echo ""
	@echo "============================================="
	@echo "Review the plan above, then run:"
	@echo "  make eks-apply"
	@echo "  make eks-kubeconfig"
	@echo "  make build-push-all IMAGE_TAG=v1"
	@echo "  make deploy-all IMAGE_TAG=v1"
	@echo "============================================="
