{
  "info": {
    "_postman_id": "user-service-api-collection",
    "name": "User Service API",
    "description": "⚠️ MINIKUBE ONLY - REST endpoints not exposed on AWS EKS\n\nOn AWS EKS, use BFF-GraphQL-API collection instead (all auth via GraphQL /graphql)\n\nThis collection calls REST endpoints (/v1/auth/login etc.) which are only available on local minikube via gRPC-gateway.\n\nFlow: Kong -> gRPC Gateway -> User Service -> MongoDB",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://192.168.49.2:30080",
      "description": "⚠️ Minikube IP only - NOT for AWS EKS. On EKS use BFF-GraphQL-API collection."
    },
    {
      "key": "tenantId",
      "value": "tenant-1",
      "description": "Tenant ID for multi-tenancy"
    },
    {
      "key": "accessToken",
      "value": "",
      "description": "JWT Access Token (auto-set after login/register)"
    },
    {
      "key": "refreshToken",
      "value": "",
      "description": "JWT Refresh Token (auto-set after login/register)"
    },
    {
      "key": "userId",
      "value": "",
      "description": "User ID (auto-set after register)"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/healthz",
          "host": ["{{baseUrl}}"],
          "path": ["healthz"]
        },
        "description": "Check if the API gateway is healthy"
      },
      "response": []
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.user) {",
                  "        pm.collectionVariables.set('userId', jsonData.user.id);",
                  "    }",
                  "    if (jsonData.tokens) {",
                  "        pm.collectionVariables.set('accessToken', jsonData.tokens.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', jsonData.tokens.refreshToken);",
                  "    }",
                  "    pm.test('User registered successfully', function () {",
                  "        pm.expect(jsonData.user).to.be.an('object');",
                  "        pm.expect(jsonData.user.email).to.exist;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test@123456\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"display_name\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "register"]
            },
            "description": "Register a new user account.\n\nPassword requirements:\n- Minimum 8 characters\n- At least 1 uppercase letter\n- At least 1 lowercase letter\n- At least 1 number\n- At least 1 special character"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.user) {",
                  "        pm.collectionVariables.set('userId', jsonData.user.id);",
                  "    }",
                  "    if (jsonData.tokens) {",
                  "        pm.collectionVariables.set('accessToken', jsonData.tokens.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', jsonData.tokens.refreshToken);",
                  "    }",
                  "    pm.test('Login successful', function () {",
                  "        pm.expect(jsonData.user).to.be.an('object');",
                  "        pm.expect(jsonData.tokens).to.be.an('object');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "description": "Login with email and password"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.tokens) {",
                  "        pm.collectionVariables.set('accessToken', jsonData.tokens.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', jsonData.tokens.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "refresh"]
            },
            "description": "Get new access token using refresh token"
          },
          "response": []
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access_token\": \"{{accessToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/validate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "validate"]
            },
            "description": "Validate if access token is still valid"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout"]
            },
            "description": "Logout and invalidate refresh token"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints"
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}",
                "description": "Tenant ID for multi-tenancy"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "JWT Access Token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "{{userId}}"]
            },
            "description": "Get user details by user ID"
          },
          "response": []
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}",
                "description": "Tenant ID for multi-tenancy"
              },
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "description": "Current User ID"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "JWT Access Token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "me"]
            },
            "description": "Get current authenticated user's profile"
          },
          "response": []
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}",
                "description": "Tenant ID for multi-tenancy"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "JWT Access Token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users?page=1&page_size=10",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                },
                {
                  "key": "status_filter",
                  "value": "1",
                  "disabled": true,
                  "description": "1=ACTIVE, 2=INACTIVE, 3=SUSPENDED, 4=DELETED"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true,
                  "description": "Search by email or name"
                }
              ]
            },
            "description": "List all users with pagination"
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}",
                "description": "Tenant ID for multi-tenancy"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "JWT Access Token"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Updated\",\n  \"last_name\": \"Name\",\n  \"display_name\": \"Updated Display Name\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "{{userId}}"]
            },
            "description": "Update user profile"
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}",
                "description": "Tenant ID for multi-tenancy"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "JWT Access Token"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"Test@123456\",\n  \"new_password\": \"NewTest@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "{{userId}}", "change-password"]
            },
            "description": "Change user password"
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}",
                "description": "Tenant ID for multi-tenancy"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "JWT Access Token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "{{userId}}"]
            },
            "description": "Soft delete user (marks as DELETED status)"
          },
          "response": []
        }
      ],
      "description": "User management endpoints"
    }
  ]
}
