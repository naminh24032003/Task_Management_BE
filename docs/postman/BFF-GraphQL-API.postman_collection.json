{
  "info": {
    "_postman_id": "bff-graphql-api-collection",
    "name": "BFF GraphQL API",
    "description": "GraphQL API collection for BFF Service\n\nArchitecture: Kong -> BFF (GraphQL) -> User/Task Service (gRPC)\n\nAll requests go through the /graphql endpoint.\n\nTested and verified on Minikube.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080",
      "description": "Base URL - use kubectl port-forward -n kong svc/kong-kong-proxy 18080:80"
    },
    {
      "key": "tenantId",
      "value": "tenant-1",
      "description": "Tenant ID for multi-tenancy"
    },
    {
      "key": "accessToken",
      "value": "",
      "description": "JWT Access Token (auto-set after login/register)"
    },
    {
      "key": "refreshToken",
      "value": "",
      "description": "JWT Refresh Token (auto-set after login/register)"
    },
    {
      "key": "userId",
      "value": "",
      "description": "User ID (auto-set after login/register)"
    }
  ],
  "item": [
    {
      "name": "Auth (Public)",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.register) {",
                  "        var register = jsonData.data.register;",
                  "        if (register.user) {",
                  "            pm.collectionVariables.set('userId', register.user.id);",
                  "        }",
                  "        pm.test('User registered successfully', function () {",
                  "            pm.expect(register.success).to.be.true;",
                  "            pm.expect(register.user).to.be.an('object');",
                  "            pm.expect(register.user.tenantId).to.equal(pm.collectionVariables.get('tenantId'));",
                  "        });",
                  "    }",
                  "    if (jsonData.errors) {",
                  "        pm.test('Registration failed', function() {",
                  "            pm.expect.fail(jsonData.errors[0].message);",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    user {\n      id\n      tenantId\n      email\n      firstName\n      lastName\n      displayName\n      status\n      roleIds\n    }\n    success\n    message\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"tenantId\": \"{{tenantId}}\",\n    \"email\": \"test@example.com\",\n    \"password\": \"Test@123456\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Register a new user account.\n\nPassword requirements:\n- Minimum 8 characters\n- At least 1 uppercase letter\n- At least 1 lowercase letter\n- At least 1 number\n- At least 1 special character"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.login) {",
                  "        var login = jsonData.data.login;",
                  "        if (login.user) {",
                  "            pm.collectionVariables.set('userId', login.user.id);",
                  "        }",
                  "        if (login.tokens) {",
                  "            pm.collectionVariables.set('accessToken', login.tokens.accessToken);",
                  "            pm.collectionVariables.set('refreshToken', login.tokens.refreshToken);",
                  "        }",
                  "        pm.test('Login successful', function () {",
                  "            pm.expect(login.user).to.be.an('object');",
                  "            pm.expect(login.user.tenantId).to.equal(pm.collectionVariables.get('tenantId'));",
                  "            pm.expect(login.tokens).to.be.an('object');",
                  "            pm.expect(login.tokens.accessToken).to.be.a('string');",
                  "        });",
                  "    }",
                  "    if (jsonData.errors) {",
                  "        pm.test('Login failed', function() {",
                  "            pm.expect.fail(jsonData.errors[0].message);",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($input: LoginInput!) {\n  login(input: $input) {\n    user {\n      id\n      tenantId\n      email\n      firstName\n      lastName\n      displayName\n      status\n      roleIds\n      createdAt\n      updatedAt\n      lastLoginAt\n    }\n    tokens {\n      accessToken\n      refreshToken\n      expiresIn\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"tenantId\": \"{{tenantId}}\",\n    \"email\": \"test@example.com\",\n    \"password\": \"Test@123456\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Login with email and password.\n\nReturns:\n- user: User object with tenantId, email, timestamps, etc.\n- tokens: accessToken, refreshToken, expiresIn (3600 seconds)"
          },
          "response": []
        },
        {
          "name": "Google Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.googleLogin) {",
                  "        var login = jsonData.data.googleLogin;",
                  "        if (login.user) {",
                  "            pm.collectionVariables.set('userId', login.user.id);",
                  "        }",
                  "        if (login.tokens) {",
                  "            pm.collectionVariables.set('accessToken', login.tokens.accessToken);",
                  "            pm.collectionVariables.set('refreshToken', login.tokens.refreshToken);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation GoogleLogin($input: GoogleLoginInput!) {\n  googleLogin(input: $input) {\n    user {\n      id\n      tenantId\n      email\n      firstName\n      lastName\n      displayName\n      status\n      roleIds\n    }\n    tokens {\n      accessToken\n      refreshToken\n      expiresIn\n    }\n    isNewUser\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"tenantId\": \"{{tenantId}}\",\n    \"idToken\": \"YOUR_GOOGLE_ID_TOKEN_HERE\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Login with Google OAuth.\n\nRequires a valid Google ID token obtained from Google Sign-In.\n\nReturns isNewUser: true if this is a new account created via OAuth."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.refreshToken) {",
                  "        var tokens = jsonData.data.refreshToken;",
                  "        pm.collectionVariables.set('accessToken', tokens.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', tokens.refreshToken);",
                  "        pm.test('Token refreshed successfully', function () {",
                  "            pm.expect(tokens.accessToken).to.be.a('string');",
                  "            pm.expect(tokens.refreshToken).to.be.a('string');",
                  "            pm.expect(tokens.expiresIn).to.equal(3600);",
                  "        });",
                  "    }",
                  "    if (jsonData.errors) {",
                  "        pm.test('Refresh failed', function() {",
                  "            pm.expect.fail(jsonData.errors[0].message);",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RefreshToken($refreshToken: String!) {\n  refreshToken(refreshToken: $refreshToken) {\n    accessToken\n    refreshToken\n    expiresIn\n  }\n}",
                "variables": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Get new access token using refresh token.\n\nNo authentication header required - tenantId is extracted from the token itself.\n\nNote: After refresh, the old refresh token is invalidated (rotation)."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.logout) {",
                  "        pm.test('Logout successful', function () {",
                  "            pm.expect(jsonData.data.logout.success).to.be.true;",
                  "        });",
                  "        // Clear tokens after logout",
                  "        pm.collectionVariables.set('accessToken', '');",
                  "        pm.collectionVariables.set('refreshToken', '');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Logout($refreshToken: String!) {\n  logout(refreshToken: $refreshToken) {\n    success\n    message\n  }\n}",
                "variables": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Logout and invalidate refresh token.\n\nNo authentication header required."
          },
          "response": []
        }
      ],
      "description": "Public authentication endpoints - no auth header required"
    },
    {
      "name": "Users (Authenticated)",
      "item": [
        {
          "name": "Get Current User (Me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Me {\n  me {\n    id\n    tenantId\n    email\n    firstName\n    lastName\n    displayName\n    status\n    roleIds\n    createdAt\n    updatedAt\n    lastLoginAt\n  }\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Get current authenticated user's profile.\n\nRequires: Kong JWT plugin to inject x-user-id, x-tenant-id headers from token."
          },
          "response": []
        },
        {
          "name": "Get User by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetUser($id: String!) {\n  user(id: $id) {\n    id\n    tenantId\n    email\n    firstName\n    lastName\n    displayName\n    status\n    roleIds\n    createdAt\n    updatedAt\n    lastLoginAt\n  }\n}",
                "variables": "{\n  \"id\": \"{{userId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Get user details by user ID"
          },
          "response": []
        },
        {
          "name": "List Users (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ListUsers($input: ListUsersInput!) {\n  users(input: $input) {\n    users {\n      id\n      tenantId\n      email\n      firstName\n      lastName\n      displayName\n      status\n      roleIds\n    }\n    total\n    page\n    pageSize\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"page\": 1,\n    \"pageSize\": 10\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "List all users with pagination.\n\nRequires: admin role"
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateUser($id: String!, $input: UpdateUserInput!) {\n  updateUser(id: $id, input: $input) {\n    id\n    tenantId\n    email\n    firstName\n    lastName\n    displayName\n    status\n    roleIds\n  }\n}",
                "variables": "{\n  \"id\": \"{{userId}}\",\n  \"input\": {\n    \"firstName\": \"Updated\",\n    \"lastName\": \"Name\",\n    \"displayName\": \"Updated Display Name\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Update user profile.\n\nUsers can only update themselves unless they have admin role."
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation ChangePassword($input: ChangePasswordInput!) {\n  changePassword(input: $input) {\n    success\n    message\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"currentPassword\": \"Test@123456\",\n    \"newPassword\": \"NewTest@123456\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Change current user's password"
          },
          "response": []
        },
        {
          "name": "Create User (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateUser($input: CreateUserInput!) {\n  createUser(input: $input) {\n    id\n    tenantId\n    email\n    firstName\n    lastName\n    displayName\n    status\n    roleIds\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"tenantId\": \"{{tenantId}}\",\n    \"email\": \"newuser@example.com\",\n    \"password\": \"Test@123456\",\n    \"firstName\": \"New\",\n    \"lastName\": \"User\",\n    \"roleIds\": []\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Create a new user.\n\nRequires: admin role"
          },
          "response": []
        },
        {
          "name": "Delete User (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation DeleteUser($id: String!) {\n  deleteUser(id: $id) {\n    success\n    message\n  }\n}",
                "variables": "{\n  \"id\": \"{{userId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Soft delete user (marks as DELETED status).\n\nRequires: admin role"
          },
          "response": []
        },
        {
          "name": "Assign Roles (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation AssignRoles($input: AssignRolesInput!) {\n  assignRoles(input: $input) {\n    id\n    tenantId\n    email\n    roleIds\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"userId\": \"{{userId}}\",\n    \"roleIds\": [\"admin\"]\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Assign roles to user.\n\nRequires: admin role"
          },
          "response": []
        },
        {
          "name": "Remove Roles (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RemoveRoles($input: RemoveRolesInput!) {\n  removeRoles(input: $input) {\n    id\n    tenantId\n    email\n    roleIds\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"userId\": \"{{userId}}\",\n    \"roleIds\": [\"admin\"]\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Remove roles from user.\n\nRequires: admin role"
          },
          "response": []
        }
      ],
      "description": "User management endpoints - requires authentication.\n\nNote: These endpoints require Kong JWT plugin to be configured to inject user headers from the token."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ]
}
