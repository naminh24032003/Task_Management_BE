{
  "info": {
    "_postman_id": "bff-graphql-api-collection-v2",
    "name": "BFF GraphQL API - EKS",
    "description": "Complete GraphQL API collection for Task Management BFF Service\n\n\ud83c\udf10 AWS EKS: http://a6671e74f33cd4af2be19ebf89874aa8-6be48b89dec3f532.elb.ap-southeast-1.amazonaws.com\n\ud83d\udcbb Local Minikube: http://localhost:18080\n\n\ud83d\udccb Flow:\n1. Run Login \u2192 auto-saves accessToken + refreshToken + userId\n2. Run Create Task \u2192 auto-saves taskId\n3. All authenticated requests use {{accessToken}} Bearer token automatically\n\n\ud83d\udd11 Test account: devtest@example.com / Test@123456 / tenant-1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://a6671e74f33cd4af2be19ebf89874aa8-6be48b89dec3f532.elb.ap-southeast-1.amazonaws.com", "description": "EKS NLB URL. For local minikube: http://localhost:18080" },
    { "key": "tenantId", "value": "tenant-1" },
    { "key": "accessToken", "value": "", "description": "Auto-set after Login" },
    { "key": "refreshToken", "value": "", "description": "Auto-set after Login" },
    { "key": "userId", "value": "", "description": "Auto-set after Login" },
    { "key": "taskId", "value": "", "description": "Auto-set after Create Task" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "if (json.data && json.data.login) {",
            "    var login = json.data.login;",
            "    pm.collectionVariables.set('accessToken', login.tokens.accessToken);",
            "    pm.collectionVariables.set('refreshToken', login.tokens.refreshToken);",
            "    pm.collectionVariables.set('userId', login.user.id);",
            "    pm.test('Login OK', () => { pm.expect(login.tokens.accessToken).to.be.a('string').and.not.empty; });",
            "    console.log('Tokens saved. userId:', login.user.id);",
            "}",
            "if (json.errors) { pm.test('Login failed: ' + json.errors[0].message, () => pm.expect.fail()); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "graphql", "graphql": {
              "query": "mutation Login($input: LoginInput!) {\n  login(input: $input) {\n    tokens {\n      accessToken\n      refreshToken\n      expiresIn\n    }\n    user {\n      id\n      tenantId\n      email\n      firstName\n      lastName\n      displayName\n      status\n      roleIds\n    }\n  }\n}",
              "variables": "{\n  \"input\": {\n    \"tenantId\": \"{{tenantId}}\",\n    \"email\": \"devtest@example.com\",\n    \"password\": \"Test@123456\"\n  }\n}"
            }},
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "description": "Login. Auto-saves accessToken, refreshToken, userId.\n\nResponse shape: data.login.tokens.accessToken (NOT data.login.accessToken)"
          },
          "response": []
        },
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "if (json.data && json.data.register && json.data.register.user) {",
            "    pm.collectionVariables.set('userId', json.data.register.user.id);",
            "    pm.test('Register OK', () => pm.expect(json.data.register.success).to.be.true);",
            "}",
            "if (json.errors) { pm.test('Register failed: ' + json.errors[0].message, () => pm.expect.fail()); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "graphql", "graphql": {
              "query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    user {\n      id\n      tenantId\n      email\n      firstName\n      lastName\n      status\n    }\n    success\n    message\n  }\n}",
              "variables": "{\n  \"input\": {\n    \"tenantId\": \"{{tenantId}}\",\n    \"email\": \"newuser@example.com\",\n    \"password\": \"Test@123456\",\n    \"firstName\": \"New\",\n    \"lastName\": \"User\"\n  }\n}"
            }},
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "if (json.data && json.data.refreshToken) {",
            "    pm.collectionVariables.set('accessToken', json.data.refreshToken.accessToken);",
            "    pm.collectionVariables.set('refreshToken', json.data.refreshToken.refreshToken);",
            "    pm.test('Refresh OK', () => pm.expect(json.data.refreshToken.accessToken).to.be.a('string'));",
            "}",
            "if (json.errors) { pm.test('Refresh failed: ' + json.errors[0].message, () => pm.expect.fail()); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "graphql", "graphql": {
              "query": "mutation RefreshToken($refreshToken: String!) {\n  refreshToken(refreshToken: $refreshToken) {\n    accessToken\n    refreshToken\n    expiresIn\n  }\n}",
              "variables": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }},
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "description": "Get new tokens. Old refresh token is invalidated (rotation). Auto-saves new tokens."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "if (json.data && json.data.logout && json.data.logout.success) {",
            "    pm.collectionVariables.set('accessToken', '');",
            "    pm.collectionVariables.set('refreshToken', '');",
            "    pm.test('Logout OK', () => pm.expect(json.data.logout.success).to.be.true);",
            "    console.log('Logged out, tokens cleared');",
            "}",
            "if (json.errors) { pm.test('Logout failed: ' + json.errors[0].message, () => pm.expect.fail()); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "graphql", "graphql": {
              "query": "mutation Logout($refreshToken: String!) {\n  logout(refreshToken: $refreshToken) {\n    success\n    message\n  }\n}",
              "variables": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }},
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "description": "Logout. Takes refreshToken directly as arg (NOT input object). Clears tokens."
          },
          "response": []
        }
      ]
    },
