        },
        {
            "key": "tenantId",
            "value": "tenant-1",
            "description": "Tenant ID"
        },
        {
            "key": "taskId",
            "value": "",
            "description": "Task ID (auto-set after create task)"
        }
    ],
    "item": [
        {
            "name": "System",
            "item": [
                {
