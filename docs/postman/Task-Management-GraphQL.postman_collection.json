            ]
        },
        {
            "name": "Tasks",
            "item": [
                {
                    "name": "Create Task",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.data && jsonData.data.createTask) {",
                                    "    pm.environment.set(\"last_task_id\", jsonData.data.createTask.id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "x-user-id",
                                "value": "69725a444f819103020c0978"
                            },
                            {
                                "key": "x-tenant-id",
                                "value": "tenant_123"
                            },
                            {
                                "key": "x-user-roles",
                                "value": "admin,user"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation CreateTask($input: CreateTaskInput!) {\n  createTask(input: $input) {\n    id\n    title\n    description\n    status\n    priority\n    projectId\n    spaceId\n    creatorId\n    tags\n  }\n}",
                                "variables": "{\n  \"input\": {\n    \"title\": \"Build Postman Collection\",\n    \"description\": \"Automatically created for testing\",\n    \"status\": \"OPEN\",\n    \"priority\": \"HIGH\",\n    \"projectId\": \"project_abc_123\",\n    \"spaceId\": \"space_xyz_789\",\n    \"tags\": [\"test\", \"api\"],\n    \"dueDate\": \"2026-02-01T00:00:00Z\"\n  }\n}"
                            }
                        },
                        "url": {
                            "raw": "{{KONG_URL}}/graphql",
                            "host": [
                                "{{KONG_URL}}"
                            ],
                            "path": [
                                "graphql"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "List Tasks",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "x-user-id",
                                "value": "69725a444f819103020c0978"
                            },
                            {
                                "key": "x-tenant-id",
                                "value": "tenant_123"
                            },
                            {
                                "key": "x-user-roles",
                                "value": "admin,user"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query ListTasks($input: ListTasksInput!) {\n  tasks(input: $input) {\n    tasks {\n      id\n      title\n      status\n      priority\n      projectId\n      creatorId\n    }\n    total\n    page\n    pageSize\n  }\n}",
                                "variables": "{\n  \"input\": {\n    \"page\": 1,\n    \"pageSize\": 10\n  }\n}"
                            }
                        },
                        "url": {
                            "raw": "{{KONG_URL}}/graphql",
                            "host": [
                                "{{KONG_URL}}"
                            ],
                            "path": [
                                "graphql"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Update Task Status",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "x-user-id",
                                "value": "69725a444f819103020c0978"
                            },
                            {
                                "key": "x-tenant-id",
                                "value": "tenant_123"
                            },
                            {
                                "key": "x-user-roles",
                                "value": "admin,user"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation UpdateTaskStatus($id: ID!, $status: TaskStatus!) {\n  updateTaskStatus(id: $id, status: $status) {\n    id\n    title\n    status\n  }\n}",
                                "variables": "{\n  \"id\": \"{{last_task_id}}\",\n  \"status\": \"IN_PROGRESS\"\n}"
                            }
                        },
                        "url": {
                            "raw": "{{KONG_URL}}/graphql",
                            "host": [
                                "{{KONG_URL}}"
                            ],
                            "path": [
                                "graphql"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "KONG_URL",
            "value": "http://localhost:8000"
        }
    ]
